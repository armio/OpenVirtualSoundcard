<ul class="overview">
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<section class="license">
  <h3{{#if first_of_kind}} id="{{id}}"{{/if}}>{{name}}</h3>
  <p class="used-by">Used by:
  {{#each used_by}}
    <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}},{{/unless}}
  {{/each}}
  </p>
  {{#unless source_path}}{{#if (or (eq id "MIT") (eq id "BSD-2-Clause") (eq id "BSD-3-Clause") (eq id "ISC"))}}
  <p class="used-by">This is the licence's standard text, whose copyright
  line is left blank. The copyright holders are the crates' authors:
  {{#each used_by}}
    {{crate.name}} {{crate.version}}: {{#if crate.authors}}{{#each crate.authors}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{else}}the authors named in its repository{{/if}}{{#unless @last}};{{else}}.{{/unless}}
  {{/each}}
  </p>
  {{/if}}{{/unless}}
  <pre>{{text}}</pre>
</section>
{{/each}}
